NODE_ENV=production
VITE_ENV_NAME=nvidia-igx
VITE_COMPANY_NAME="NVIDIA"
CUSTOM_STYLES=true
VITE_HIDE_FIRMWARE_INVENTORY_CHECKBOX=true
VITE_HIDE_FIRMWARE_TARGETS=true
VITE_HIDE_INVENTORY_LED=true
CUSTOM_ROUTER=true
CUSTOM_STORE=true
CUSTOM_APP_NAV=true
VITE_HIDE_SYSTEM_DUMP=true
VITE_NTP_SERVER_NUMBER=6
VITE_ENABLE_CUSTOM_KEYS=false